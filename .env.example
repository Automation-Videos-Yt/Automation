# ---- LLM providers ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# API-side LangChain model for cost optimization suggestions
OPENAI_MODEL_COST_ANALYSIS=gpt-4o-mini
ENABLE_LANGCHAIN_COST_ANALYSIS=true

# ---- Text-to-speech ----
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- YouTube (Phase 3) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback

# ---- Stock media (Phase 2) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Infrastructure ----
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/youtube_automation?schema=public
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai:8000
API_PORT=4000
STORAGE_PATH=/storage
PUBLIC_API_URL=http://localhost:4000

# ---- Worker scaling ----
# all | video | upload | enrichment
WORKER_ROLE=all
WORKER_CONCURRENCY=1
UPLOAD_WORKER_CONCURRENCY=1
ENRICHMENT_WORKER_CONCURRENCY=2
ENABLE_ANALYTICS_CRON=true

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Feature flags ----
# Off by default: YouTube rejects custom thumbnails from unverified channels anyway.
# Set to "true" once your channel is phone-verified at https://youtube.com/verify.
ENABLE_THUMBNAIL_AGENT=false

# Hook A/B testing (one topic -> multiple hook-variant videos)
ENABLE_HOOK_AB_TESTING=true
HOOK_AB_VARIANTS=3
HOOK_AB_AUTO_UPLOAD=true
HOOK_AB_UPLOAD_PRIVACY=PRIVATE

# Pipeline completion auto-upload scheduler
AUTO_UPLOAD_ON_PIPELINE_DONE=false
AUTO_UPLOAD_PRIVACY=PUBLIC
# Delay upload by N minutes after pipeline completion. 0 = immediate.
AUTO_UPLOAD_DELAY_MINUTES=0
