generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PipelineStage {
  QUEUED
  TOPIC
  SCRIPT
  HOOK
  PREDICTION
  TIMESTAMP
  VIDEO_SELECTION
  VOICE
  VIDEO
  THUMBNAIL
  DONE
  FAILED
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AgentLogStatus {
  SUCCESS
  FAILED
}

enum UploadStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum UploadPrivacy {
  PRIVATE
  UNLISTED
  PUBLIC
}

model PipelineRun {
  id                 String         @id @default(cuid())
  experimentId       String?
  niche              String
  languageCode       String         @default("en")
  targetDurationSec  Int            @default(75)
  stage              PipelineStage  @default(QUEUED)
  status             RunStatus      @default(QUEUED)
  currentAgent       String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  failedStage        PipelineStage?
  stageFailureReason String?
  stageFailureMeta   Json?
  stageRetryCounts   Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  topic        Topic?
  script       Script?
  hookVariants HookVariant[]
  voiceAsset   VoiceAsset?
  scenes       Scene[]
  video        Video?
  logs         AgentLog[]
  costRecords  AiCostRecord[]
  upload       YouTubeUpload?
  analytics    VideoAnalytics[]
  feedback     FeedbackInsight?
  prediction   PerformancePrediction?

  @@index([status, stage])
  @@index([experimentId])
  @@index([createdAt])
}

model Topic {
  id             String      @id @default(cuid())
  runId          String      @unique
  run            PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  title          String
  angle          String
  rationale      String
  trendScore     Float       @default(0)
  // Embedding of "title. angle" used for duplicate-topic detection on future runs.
  titleEmbedding Float[]
  createdAt      DateTime    @default(now())
}

model Script {
  id                  String      @id @default(cuid())
  runId               String      @unique
  run                 PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  hook                String
  body                String      @db.Text
  cta                 String
  wordCount           Int
  durationEstimateSec Int
  createdAt           DateTime    @default(now())
}

model HookVariant {
  id        String      @id @default(cuid())
  runId     String
  run       PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index     Int
  text      String
  score     Float
  reasoning String?
  chosen    Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([runId, index])
}

model VoiceAsset {
  id          String      @id @default(cuid())
  runId       String      @unique
  run         PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  audioPath   String
  durationSec Float
  voiceId     String
  createdAt   DateTime    @default(now())
}

model Scene {
  id              String      @id @default(cuid())
  runId           String
  run             PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index           Int
  startSec        Float
  endSec          Float
  text            String      @db.Text
  query           String?
  clipUrl         String?
  clipSource      String?
  clipPath        String?
  clipDurationSec Float?
  createdAt       DateTime    @default(now())

  @@unique([runId, index])
}

model Video {
  id            String      @id @default(cuid())
  runId         String      @unique
  run           PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  videoPath     String
  thumbnailPath String?
  title         String?
  description   String?     @db.Text
  tags          String[]
  createdAt     DateTime    @default(now())
}

model AgentLog {
  id           String         @id @default(cuid())
  runId        String
  run          PipelineRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent        String
  inputJson    Json
  outputJson   Json?
  durationMs   Int
  status       AgentLogStatus
  errorMessage String?
  createdAt    DateTime       @default(now())

  @@index([runId, createdAt])
}

model AiCostRecord {
  id            String      @id @default(cuid())
  runId         String
  run           PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  operation     String
  promptVersion String?
  tokensInput   Int?
  tokensOutput  Int?
  audioChars    Int?
  audioSeconds  Float?
  costUsd       Float
  latencyMs     Int?
  createdAt     DateTime    @default(now())

  @@index([runId])
  @@index([provider, model])
}

model AiCache {
  id        String   @id @default(cuid())
  taskType  String
  inputHash String
  output    Json
  provider  String
  model     String
  createdAt DateTime @default(now())

  @@unique([taskType, inputHash])
}

// Singleton row (id = "default") that stores the refresh token for the linked YouTube channel.
model YouTubeAccount {
  id             String   @id @default("default")
  channelId      String?
  channelTitle   String?
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  scope          String
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model YouTubeUpload {
  id             String        @id @default(cuid())
  runId          String        @unique
  run            PipelineRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  status         UploadStatus  @default(PENDING)
  privacy        UploadPrivacy @default(PRIVATE)
  youtubeVideoId String?
  videoUrl       String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

// Phase 4 — analytics / feedback / vector memory.

model VideoAnalytics {
  id                 String      @id @default(cuid())
  runId              String
  run                PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  snapshotAt         DateTime    @default(now())
  views              Int         @default(0)
  likes              Int         @default(0)
  comments           Int         @default(0)
  shares             Int?
  impressions        Int?
  ctr                Float?
  avgViewDurationSec Float?
  avgViewPercentage  Float?
  watchTimeMinutes   Float?
  subsGained         Int?

  @@index([runId, snapshotAt])
}

model PerformancePrediction {
  id                 String      @id @default(cuid())
  runId              String      @unique
  run                PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  predictedCtr       Float // expected % CTR (0-30)
  predictedRetention Float // expected avg view % (0-100)
  score              Float // combined 0-10
  reasoning          String      @db.Text
  createdAt          DateTime    @default(now())
}

model FeedbackInsight {
  id             String      @id @default(cuid())
  runId          String      @unique
  run            PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  whatWorked     String      @db.Text
  whatDidnt      String      @db.Text
  suggestions    String      @db.Text
  performanceTag String // e.g. "strong", "mid", "weak"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TopicMemory {
  id          String   @id @default(cuid())
  runId       String?  @unique // nullable so we can seed manually too
  niche       String
  topicTitle  String
  topicAngle  String
  ctr         Float?
  views       Int?
  avgViewPct  Float?
  performance Float // normalized score used to break ties / rank
  embedding   Float[] // text-embedding-3-small, 1536 dims
  createdAt   DateTime @default(now())

  @@index([niche])
}

model HookMemory {
  id          String   @id @default(cuid())
  runId       String?  @unique
  niche       String
  topicTitle  String
  hookText    String   @db.Text
  ctr         Float?
  views       Int?
  avgViewPct  Float?
  performance Float
  embedding   Float[]
  createdAt   DateTime @default(now())

  @@index([niche])
}

model PipelineSchedule {
  id             String   @id @default(cuid())
  niche          String
  languageCode   String   @default("en")
  cronExpression String
  repeatJobKey   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
