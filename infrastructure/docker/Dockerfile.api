FROM node:20-alpine AS builder

# Prisma needs the openssl binary for engine detection on Alpine 3.19+.
RUN apk add --no-cache openssl

WORKDIR /app

# Workspace manifests first for cache efficiency
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/pricing/package.json packages/pricing/package.json

RUN npm install

# Source
COPY apps/api apps/api
COPY packages/pricing packages/pricing

WORKDIR /app/apps/api
RUN npx prisma generate
RUN npm run build


FROM node:20-alpine AS runner

RUN apk add --no-cache openssl

WORKDIR /app

# Copy package descriptors for prod install
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/pricing/package.json packages/pricing/package.json

# Install only production dependencies
RUN npm install --workspace=@youtube-automation/api --omit=dev --include-workspace-root

# Copy compiled source and prisma client from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/packages/pricing ./packages/pricing

WORKDIR /app/apps/api
RUN npx prisma generate

EXPOSE 4000

CMD ["npm", "start"]
