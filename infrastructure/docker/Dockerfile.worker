FROM node:20-alpine AS builder

# ffmpeg + a font that DejaVu Sans resolves to (fontconfig is required for the subtitles filter).
RUN apk add --no-cache ffmpeg ttf-dejavu fontconfig openssl && fc-cache -f

WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/pricing/package.json packages/pricing/package.json

RUN npm install

# Source: worker code + api's prisma schema (shared client).
COPY apps/api/prisma apps/api/prisma
COPY apps/worker apps/worker
COPY packages/pricing packages/pricing

# Build the pricing package first so its dist/ is available to the worker
WORKDIR /app
RUN npm run build --workspace=packages/pricing

WORKDIR /app/apps/worker
RUN npx prisma generate --schema=../api/prisma/schema.prisma
RUN npm run build


FROM node:20-alpine AS runner

RUN apk add --no-cache ffmpeg ttf-dejavu fontconfig openssl && fc-cache -f

WORKDIR /app

# Copy package descriptors for prod install
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/pricing/package.json packages/pricing/package.json

# Install only production dependencies
RUN npm install --workspace=@youtube-automation/worker --omit=dev --include-workspace-root

# Copy compiled source and prisma schema from builder
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/packages/pricing ./packages/pricing

WORKDIR /app/apps/worker
RUN npx prisma generate --schema=../api/prisma/schema.prisma

CMD ["npm", "start"]
